#!/usr/bin/env python3
"""codex-app-server — Managed Codex B-2 App Server CLI Entrypoint

SPEC-004 / TICKET-004a / Release Re-review:
Provides managed lifecycle control, endpoint allowlist verification,
ephemeral capability token lifecycle on tmpfs, and deterministic cleanup.
"""

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_CANDIDATES = [
    _HERE.parents[1],                      # relative repo / container root
    Path("/run/ext/codex-dist"),           # in-container injected
    Path("/run/ext/harness"),              # in-container injected harness
    Path("/opt/ext/fhs/codex"),            # in-container fhs
]
for p in _CANDIDATES:
    if p.exists() and str(p) not in sys.path:
        sys.path.insert(0, str(p))

try:
    from platforms.codex.harness.app_server_service import run_managed_b2_entrypoint
except ImportError:
    try:
        from harness.app_server_service import run_managed_b2_entrypoint
    except ImportError:
        import app_server_service
        run_managed_b2_entrypoint = app_server_service.run_managed_b2_entrypoint

if __name__ == "__main__":
    sys.exit(run_managed_b2_entrypoint())
