# Install (on the host, after choosing the egress IP and allowlist path):
#   1. Copy egress/egress_proxy.py and egress/egress-allow.txt.template to /etc/container-ctl/egress/
#      (rename the template to egress-allow.txt and review every host).
#   2. Create the isolated network for the service user:
#      podman network create --internal container-egress   # or an isolated bridge with the proxy as the only route
#   3. Fill in @SERVICE_USER@ and @EGRESS_IP@ and install as a user or system unit:
#      sed -e 's|@SERVICE_USER@|<service-user>|g' -e 's|@EGRESS_IP@|<ip on the egress network>|' \
#          egress/egress-proxy.service.template > /etc/systemd/system/egress-proxy.service
#      systemctl daemon-reload && systemctl enable --now egress-proxy.service
#
# Rollback: systemctl disable --now egress-proxy; rm the unit; daemon-reload;
#           podman network rm container-egress (as @SERVICE_USER@).

[Unit]
Description=Allowlist CONNECT proxy for isolated containers
After=network-online.target
Wants=network-online.target

[Service]
User=@SERVICE_USER@
Type=simple
Restart=on-failure
RestartSec=2s
Environment=PYTHONUNBUFFERED=1
# Direct Python on the host (simplest; the proxy has no third-party deps):
ExecStart=/usr/bin/python3 /etc/container-ctl/egress/egress_proxy.py \
    --listen @EGRESS_IP@:3128 \
    --allowlist /etc/container-ctl/egress/egress-allow.txt \
    --log /var/log/container-ctl/egress.jsonl

# Alternative: run inside a rootless podman container joined to both `container-egress` (internal) and the default
# podman network (outbound). Uncomment this block and comment the ExecStart above when the network layout requires it:
# ExecStartPre=-/usr/bin/podman rm -f container-egress-proxy
# ExecStart=/usr/bin/podman run --rm --name container-egress-proxy \
#     --network container-egress:ip=@EGRESS_IP@ --network podman \
#     --read-only --cap-drop=ALL --security-opt=no-new-privileges \
#     -v /etc/container-ctl/egress:/etc/container-ctl/egress:ro \
#     -v /var/log/container-ctl:/var/log/container-ctl:rw \
#     --label container-ctl.domain=exec --label container-ctl.group=egress --label container-ctl.tier=T2 \
#     python:3.12-slim python3 /etc/container-ctl/egress/egress_proxy.py \
#     --listen @EGRESS_IP@:3128 \
#     --allowlist /etc/container-ctl/egress/egress-allow.txt \
#     --log /var/log/container-ctl/egress.jsonl
# ExecStop=/usr/bin/podman stop -t 5 container-egress-proxy

[Install]
WantedBy=multi-user.target
