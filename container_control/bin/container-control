#!/usr/bin/env bash
# ==============================================================================
# Container Control - In-Container Service Control & Lifecycle CLI
# ==============================================================================
set -euo pipefail

_here="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"   # package root (container-ctl)

export PYTHONPATH="/run/ext/packages:/opt/ext/fhs/packages:/opt/ext/fhs/container-control:${_here}:${PYTHONPATH:-}"
exec python3 -m container_control.cli "$@"
