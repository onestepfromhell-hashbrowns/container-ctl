name: CI

on:
  push:
    branches: ["main", "master", "cleanup/**"]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.11", "3.12", "3.13"]
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install package and test dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e ".[dev]"
      - name: Run container-ctl unit tests
        run: |
          python -m pytest tests -p no:cacheprovider -q
      - name: Run container-doctor unit tests
        run: |
          PYTHONPATH=tools/container-doctor python -m pytest tools/container-doctor/container_doctor/tests -p no:cacheprovider -q
      - name: Run container_control unit tests
        run: |
          python -m pytest container_control/tests -p no:cacheprovider -q
